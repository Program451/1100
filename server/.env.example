# Сетевые настройки
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=senim.db

# Правила риска из общего контракта
RISK_WINDOW_MINUTES=30
RISK_AMOUNT_THRESHOLD=100000
RISK_AMOUNT_THRESHOLD_WITH_SIGNAL=50000
TRANSFER_PENDING_SECONDS=120
DECOY_TTL_SECONDS=300
CALL_ALERT_SCORE=0.85
OFFLINE_LIMIT=50000

# Секрет задаётся только в локальном .env или окружении.
FCM_SERVER_KEY=
# Путь к локальному JSON сервисного аккаунта Firebase; сам файл не помещать в Git.
GOOGLE_APPLICATION_CREDENTIALS=

